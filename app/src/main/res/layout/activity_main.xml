<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context="com.ads.demo.MainActivity">

        <RelativeLayout
            android:id="@+id/ll_ads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/normal_bound"
            android:orientation="vertical">

            <Button
                android:id="@+id/showInter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Show inters Ads" />

            <Button
                android:id="@+id/showFCNative"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/showInter"
                android:text="Show fc native" />
        </RelativeLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/fullscreen_ad_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/white"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <com.ads.yeknomadmob.ads_components.ads_native.YNMNativeAdView
                android:id="@+id/fullscreen_native_ad_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layoutLoading="@layout/native_shimmer_placeholder"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/clear_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="close ads"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <include layout="@layout/layout_ads_comp" />
    </RelativeLayout>
</layout>